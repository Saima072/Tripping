# Copy to .env for local development. In production, inject these via your
# platform's secrets manager — do not ship .env files in containers.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripswipe
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32ch-min
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
PORT=4000
CORS_ORIGIN=http://localhost:5173
